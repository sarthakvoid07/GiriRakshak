# Normalise line endings so a Windows and a Linux teammate editing the same
# file don't produce a diff where every single line changed.
* text=auto eol=lf

# Binary — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff  binary
*.woff2 binary

# Keep generated lockfiles out of pull request diffs
package-lock.json linguist-generated=true -diff
